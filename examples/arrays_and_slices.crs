let numbers = [];
numbers->push(1);
numbers->push(2);
numbers->push(3);
numbers->push_front(0);

print(numbers.length);
print(numbers[0]);
print(numbers[1:3]);

let doubled = [];

for let i = 0; i < numbers.length; i = i + 1 {
    doubled->push(numbers[i] * 2);
}

for let j = 0; j < doubled.length; j = j + 1 {
    print(doubled[j]);
}
